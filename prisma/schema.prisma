generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  FUNDED
  CONVERTING
  DISBURSING
  COMPLETED
  FAILED
  EXPIRED
}

enum Chain {
  POLYGON
  TRON
  STELLAR
  ETHEREUM
}

enum Stablecoin {
  USDT
  USDC
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum KycTier {
  TIER1
  TIER2
  TIER3
}

enum DisbursementType {
  BANK_TRANSFER
  EWALLET
}

// ─── Authentication ───────────────────────────────────────────────────────────

model ApiKey {
  id        String   @id @default(cuid())
  keyHash   String   @unique
  name      String
  scopes    String[]
  ipAllowlist String[]
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id])
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revokedAt DateTime?
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  kybStatus   KycStatus @default(PENDING)
  tier        KycTier   @default(TIER1)
  apiKeys     ApiKey[]
  wallets     Wallet[]
  onrampOrders OnrampOrder[]
  offrampOrders OfframpOrder[]
  remittanceOrders RemittanceOrder[]
  otcOrders    OtcOrder[]
  webhooks    Webhook[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Wallets ──────────────────────────────────────────────────────────────────

model Wallet {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  chain       Chain
  address     String
  stablecoin  Stablecoin
  label       String?
  createdAt   DateTime @default(now())
  @@unique([customerId, chain, stablecoin])
}

// ─── Exchange Rates ───────────────────────────────────────────────────────────

model ExchangeRate {
  id         String     @id @default(cuid())
  pair       String     // e.g. "IDR_USDT"
  bid        Decimal    @db.Decimal(20, 8)
  ask        Decimal    @db.Decimal(20, 8)
  mid        Decimal    @db.Decimal(20, 8)
  venue      String     // "indodax" | "tokocrypto" | "vwap"
  volume24h  Decimal?   @db.Decimal(20, 8)
  fetchedAt  DateTime   @default(now())

  @@index([pair, venue, fetchedAt(sort: Desc)])
}

// ─── Virtual Accounts ─────────────────────────────────────────────────────────

model VirtualAccount {
  id           String   @id @default(cuid())
  bank         String   // "BCA" | "MANDIRI" | "BNI" | "BRI"
  vaNumber     String   @unique
  orderId      String   @unique
  onrampOrder  OnrampOrder @relation(fields: [orderId], references: [id])
  amount       Decimal  @db.Decimal(20, 2)
  currency     String   @default("IDR")
  expiresAt    DateTime
  paidAt       DateTime?
  createdAt    DateTime @default(now())
}

// ─── On-Ramp Orders (IDR → Stablecoin) ───────────────────────────────────────

model OnrampOrder {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])

  // Input
  amountIdr      Decimal     @db.Decimal(20, 2)
  stablecoin     Stablecoin
  chain          Chain

  // Quote
  quotedRate     Decimal     @db.Decimal(20, 8)
  quotedAmount   Decimal     @db.Decimal(20, 8)
  spreadBps      Int         // basis points
  quoteExpiresAt DateTime

  // Settlement
  status         OrderStatus @default(PENDING)
  destinationAddress String

  // Execution results
  actualRate     Decimal?    @db.Decimal(20, 8)
  actualAmount   Decimal?    @db.Decimal(20, 8)
  onchainTxHash  String?
  onchainBlock   Int?

  // Relations
  virtualAccount VirtualAccount?
  webhookDeliveries WebhookDelivery[]

  // Metadata
  referenceId    String?     // customer's own reference
  metadata       Json?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  completedAt    DateTime?
  failedAt       DateTime?
  failReason     String?

  @@index([customerId, status])
  @@index([createdAt(sort: Desc)])
}

// ─── Off-Ramp Orders (Stablecoin → IDR) ──────────────────────────────────────

model OfframpOrder {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])

  // Input
  amountStablecoin Decimal   @db.Decimal(20, 8)
  stablecoin     Stablecoin
  chain          Chain

  // Quote
  quotedRate     Decimal     @db.Decimal(20, 8)
  quotedAmountIdr Decimal    @db.Decimal(20, 2)
  spreadBps      Int
  quoteExpiresAt DateTime

  // Destination
  disbursementType DisbursementType
  bankCode       String?
  accountNumber  String?
  accountName    String?
  ewalletCode    String?     // "GOPAY" | "OVO" | "DANA" | "SHOPEEPAY" | "LINKAJA"
  ewalletPhone   String?

  // Inbound (stablecoin deposit)
  depositAddress String      // Pintas settlement address
  status         OrderStatus @default(PENDING)
  receivedTxHash String?
  receivedAmount Decimal?    @db.Decimal(20, 8)

  // Exchange execution
  actualRate     Decimal?    @db.Decimal(20, 8)
  actualAmountIdr Decimal?   @db.Decimal(20, 2)

  // Disbursement
  disbursementId String?     // DurianPay / Xendit txn ID
  disbursementRef String?    // Bank reference number

  // Relations
  webhookDeliveries WebhookDelivery[]

  // Metadata
  referenceId    String?
  metadata       Json?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  completedAt    DateTime?
  failedAt       DateTime?
  failReason     String?

  @@index([customerId, status])
  @@index([depositAddress])
  @@index([createdAt(sort: Desc)])
}

// ─── KYC Records ──────────────────────────────────────────────────────────────

model KycRecord {
  id            String    @id @default(cuid())
  customerId    String
  tier          KycTier
  status        KycStatus @default(PENDING)

  // Tier 1
  nik           String?   // National ID
  fullName      String?
  dateOfBirth   DateTime?
  selfieUrl     String?

  // Tier 2 (KYB)
  npwp          String?   // Tax ID
  companyName   String?
  nibNumber     String?   // Business registration

  // Provider response
  providerRef   String?
  providerScore Int?
  notes         String?

  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Webhooks ─────────────────────────────────────────────────────────────────

model Webhook {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  url         String
  events      String[] // ["onramp.completed", "offramp.completed", ...]
  secret      String   // HMAC signing secret
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id])
  event          String
  payload        Json
  onrampOrderId     String?
  onrampOrder       OnrampOrder?     @relation(fields: [onrampOrderId], references: [id])
  offrampOrderId    String?
  offrampOrder      OfframpOrder?    @relation(fields: [offrampOrderId], references: [id])
  remittanceOrderId String?
  remittanceOrder   RemittanceOrder? @relation(fields: [remittanceOrderId], references: [id])
  otcOrderId        String?
  otcOrder          OtcOrder?        @relation(fields: [otcOrderId], references: [id])

  attempts       Int      @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  succeededAt    DateTime?
  failedAt       DateTime?
  lastStatusCode Int?
  lastResponse   String?

  createdAt      DateTime @default(now())

  @@index([webhookId, succeededAt])
  @@index([nextAttemptAt])
}

// ─── Remittance Orders (Cross-border inbound) ─────────────────────────────────

// ─── OTC Desk ─────────────────────────────────────────────────────────────────

enum OtcStatus {
  QUOTED
  ACCEPTED
  EXECUTING
  SETTLED
  EXPIRED
  CANCELLED
  FAILED
}

enum OtcSide {
  BUY
  SELL
}

model OtcOrder {
  id               String     @id @default(cuid())
  customerId       String
  customer         Customer   @relation(fields: [customerId], references: [id])

  side             OtcSide
  stablecoin       Stablecoin
  chain            Chain

  amountIdr        Decimal    @db.Decimal(20, 2)
  amountStablecoin Decimal    @db.Decimal(20, 8)
  rate             Decimal    @db.Decimal(20, 8)
  spreadBps        Int

  status           OtcStatus  @default(QUOTED)
  expiresAt        DateTime
  acceptedAt       DateTime?
  settledAt        DateTime?

  destinationAddress String?   // for BUY orders
  bankCode           String?   // for SELL orders
  accountNumber      String?
  accountName        String?

  settlementTxHash String?
  counterpartyRef  String?
  failReason       String?

  webhookDeliveries WebhookDelivery[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([customerId, status])
  @@index([createdAt(sort: Desc)])
}

// ─── Exporter Settlement (USD → USD) ─────────────────────────────────────────

enum ExporterKybStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExporterSegment {
  FORK_B
}

enum PayoutAccountType {
  OFFSHORE_USD
  ID_BANK_USD
}

enum PayoutAccountStatus {
  ACTIVE
  INACTIVE
}

model Exporter {
  id               String              @id @default(cuid())
  legalName        String
  nib              String
  npwp             String
  country          String              @default("ID")
  segment          ExporterSegment     @default(FORK_B)
  kybStatus        ExporterKybStatus   @default(PENDING)
  kybTier          Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  payoutAccounts   PayoutAccount[]
  buyers           Buyer[]
  quotes           Quote[]
  orders           SettlementOrder[]
  webhookEndpoints WebhookEndpoint[]
}

model PayoutAccount {
  id                  String              @id @default(cuid())
  exporterId          String
  exporter            Exporter            @relation(fields: [exporterId], references: [id])
  type                PayoutAccountType
  bankName            String
  accountNumberMasked String
  accountRef          String
  currency            String              @default("USD")
  status              PayoutAccountStatus @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Buyer {
  id         String            @id @default(cuid())
  exporterId String
  exporter   Exporter          @relation(fields: [exporterId], references: [id])
  legalName  String
  country    String
  email      String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  orders     SettlementOrder[]
}

model Quote {
  id                 String   @id @default(cuid())
  exporterId         String
  exporter           Exporter @relation(fields: [exporterId], references: [id])
  invoiceAmountCents BigInt
  feeCents           BigInt
  netPayoutCents     BigInt
  pricingVersion     String
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             SettlementOrder[]
}

// ─── Settlement State Machine ─────────────────────────────────────────────────

enum SettlementStatus {
  DRAFT
  AWAITING_FUNDS
  FUNDED
  MINTING
  MINTED
  IN_TRANSIT
  ARRIVED
  REDEEMING
  REDEEMED
  PAYING_OUT
  PAID_OUT
  RECONCILED
  EXPIRED
  CANCELLED
  MINT_FAILED
  TRANSFER_FAILED
  REDEEM_FAILED
  PAYOUT_FAILED
  REFUND_PENDING
  REFUNDED
  MANUAL_REVIEW
}

model SettlementOrder {
  id                   String           @id @default(cuid())
  exporterId           String
  exporter             Exporter         @relation(fields: [exporterId], references: [id])
  buyerId              String
  buyer                Buyer            @relation(fields: [buyerId], references: [id])
  quoteId              String
  quote                Quote            @relation(fields: [quoteId], references: [id])
  invoiceRef           String
  invoiceAmountCents   BigInt
  fundedAmountCents    BigInt           @default(0)
  feeCents             BigInt
  netPayoutCents       BigInt
  status               SettlementStatus @default(DRAFT)
  statusReason         String?
  expiresAt            DateTime
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  collectionInstruction CollectionInstruction?
  incomingPayments     IncomingPayment[]
  rampOperations       RampOperation[]
  chainTransfers       ChainTransfer[]
  payouts              Payout[]
  refunds              Refund[]
  events               OrderEvent[]
  journalEntries       JournalEntry[]
  @@index([exporterId, status])
  @@index([createdAt(sort: Desc)])
}

model CollectionInstruction {
  id                String          @id @default(cuid())
  orderId           String          @unique
  order             SettlementOrder @relation(fields: [orderId], references: [id])
  provider          String
  virtualAccountRef String
  paymentReference  String          @unique
  bankDetailsJson   Json
  createdAt         DateTime        @default(now())
}

model IncomingPayment {
  id                String           @id @default(cuid())
  orderId           String?
  order             SettlementOrder? @relation(fields: [orderId], references: [id])
  provider          String
  providerPaymentId String           @unique
  amountCents       BigInt
  payerName         String?
  receivedAt        DateTime
  matchStatus       String
  createdAt         DateTime         @default(now())
}

model RampOperation {
  id              String          @id @default(cuid())
  orderId         String
  order           SettlementOrder @relation(fields: [orderId], references: [id])
  type            String
  provider        String
  providerRef     String          @unique
  amountMicroUsdc BigInt
  status          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ChainTransfer {
  id              String          @id @default(cuid())
  orderId         String
  order           SettlementOrder @relation(fields: [orderId], references: [id])
  chain           String
  fromAddress     String
  toAddress       String
  amountMicroUsdc BigInt
  txHash          String          @unique
  confirmations   Int             @default(0)
  status          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Payout {
  id              String          @id @default(cuid())
  orderId         String
  order           SettlementOrder @relation(fields: [orderId], references: [id])
  payoutAccountId String
  provider        String
  providerRef     String          @unique
  amountCents     BigInt
  status          String
  failureReason   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Refund {
  id          String          @id @default(cuid())
  orderId     String
  order       SettlementOrder @relation(fields: [orderId], references: [id])
  amountCents BigInt
  reason      String
  status      String
  providerRef String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model OrderEvent {
  id          String          @id @default(cuid())
  orderId     String
  order       SettlementOrder @relation(fields: [orderId], references: [id])
  fromStatus  String
  toStatus    String
  trigger     String
  payloadJson Json?
  actor       String
  createdAt   DateTime        @default(now())
  @@index([orderId, createdAt(sort: Desc)])
}

model JournalEntry {
  id          String          @id @default(cuid())
  orderId     String
  order       SettlementOrder @relation(fields: [orderId], references: [id])
  transition  String
  description String
  postedAt    DateTime        @default(now())
  lines       LedgerLine[]
}

model LedgerAccount {
  id    String       @id @default(cuid())
  code  String       @unique
  asset String
  type  String
  lines LedgerLine[]
}

model LedgerLine {
  id              String        @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id])
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  asset           String
  debitMinor      BigInt        @default(0)
  creditMinor     BigInt        @default(0)
}

model WebhookEndpoint {
  id         String           @id @default(cuid())
  exporterId String
  exporter   Exporter         @relation(fields: [exporterId], references: [id])
  url        String
  secret     String
  events     String[]
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deliveries WebhookDelivery2[]
}

model WebhookDelivery2 {
  id               String          @id @default(cuid())
  endpointId       String
  endpoint         WebhookEndpoint @relation(fields: [endpointId], references: [id])
  eventType        String
  payloadJson      Json
  attempt          Int             @default(1)
  nextAttemptAt    DateTime?
  status           String
  lastResponseCode Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([endpointId, status])
  @@index([nextAttemptAt])
}

model IdempotencyKey {
  key          String   @id
  route        String
  requestHash  String
  responseJson Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

enum RemittanceStatus {
  PENDING
  FUNDED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model RemittanceOrder {
  id               String           @id @default(cuid())
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id])

  corridorCode     String           // "MY" | "SA" | "AE" | "SG" | "US"
  sourceCurrency   String           // "MYR" | "SAR" | "AED" | "SGD" | "USD"
  amountSource     String           // sender amount
  feeSource        String
  netAmountSource  String
  fxRate           String           // stored as string to preserve precision
  spreadBps        Int
  quotedAmountIdr  String

  // Recipient details
  recipientName          String
  recipientBank          String?
  recipientAccountNumber String?
  recipientEwallet       String?
  recipientPhone         String?

  // Linked disbursement
  offrampOrderId   String?          @unique

  webhookDeliveries WebhookDelivery[]

  // Execution
  status           RemittanceStatus @default(PENDING)
  externalRef      String?          // partner payment reference
  expiresAt        DateTime
  completedAt      DateTime?
  failedAt         DateTime?
  failReason       String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([customerId, status])
  @@index([createdAt(sort: Desc)])
}
